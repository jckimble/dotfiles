[Unit]
Description=Sway Tiling Window Manager (AVF Native Display)
BindsTo=graphical-session.target
Before=graphical-session.target
After=graphical-session-pre.target
Wants=graphical-session-pre.target

[Service]
Type=simple
Environment=XDG_CURRENT_DESKTOP=sway
Environment=XDG_SESSION_TYPE=wayland
# Force Sway to look for virtio-gpu and bypass standard libinput physical checks
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_NO_HARDWARE_CURSORS=1
Environment=WLR_RENDERER=pixman
# Tell wlroots to target the crosvm/virtio virtual display node
Environment=WLR_BACKENDS=drm
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/sway --unsupported-gpu
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target